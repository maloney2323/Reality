{
  "name": "RealityContinuityStateV01",
  "type": "object",
  "title": "Reality Continuity State v0.1",
  "description": "Immutable, versioned epistemic state snapshot. Consequential authorization binds to this exact state ID and digest rather than a mutable current-state query.",
  "properties": {
    "continuity_state_id": { "type": "string" },
    "parent_state_id": { "type": "string" },
    "world_id": { "type": "string" },
    "transition_type": { "type": "string" },
    "transition_reason": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "epistemic_state": { "type": "object" },
    "open_debt": { "type": "array", "items": { "type": "string" } },
    "state_digest": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["VALID", "SUPERSEDED", "REVOKED"]
    }
  },
  "required": [
    "continuity_state_id",
    "world_id",
    "transition_type",
    "transition_reason",
    "state_digest",
    "created_at",
    "status"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
