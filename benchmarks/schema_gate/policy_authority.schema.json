{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reality.example/schemas/policy-authority-v1.0.schema.json",
  "title": "Reality Independent Policy Authority Registry v1.0",
  "description": "A signed registry. Its digest pin and signing public key must be supplied independently of this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_version", "authorized_policies", "signature"],
  "properties": {
    "authority_version": { "const": "reality-policy-authority-v1.0" },
    "authorized_policies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[0-9a-f]{64}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_workstream", "max_token_lifetime_seconds", "allowed_scopes", "allowed_subjects", "allowed_workflow_refs"],
        "properties": {
          "target_workstream": { "type": "string", "minLength": 1, "maxLength": 128 },
          "max_token_lifetime_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
          "allowed_scopes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "allowed_subjects": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "allowed_workflow_refs": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      }
    },
    "signature": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
