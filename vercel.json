{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/reality-shadow",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/reality/shift",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/reality/stewardship",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/chat-simple",
      "destination": "/reality-chat-simple.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/value",
      "destination": "/index.html"
    }
  ]
}
